# Copy to .env and edit. Every value here is a dummy; nothing real is committed.
# Database to protect (SQLite file). For the organisers' pack:
#   ../ds/B1_Smart_Data_Masking_PII/sql/sqlite/saffron_bank.db
SMARTMASK_SQLITE=data/bank.db
# Optional PostgreSQL (read-only application user), e.g. the pack's docker-compose database
SMARTMASK_PG_DSN=host=localhost port=5433 dbname=postgres user=smartmask_app
# Only needed to load the synthetic demo data into PostgreSQL
SMARTMASK_PG_ADMIN_DSN=host=localhost port=5433 dbname=postgres user=postgres
# Salt for hash tokens. Change it and keep it secret.
SMARTMASK_SALT=change-me
# Tags and the audit log live here, never in the protected database
SMARTMASK_META=data/smartmask_meta.db
# Optional: language-model second opinion in the AI Assist tab. Leave blank to keep it off.
ANTHROPIC_API_KEY=
SMARTMASK_LLM_MODEL=claude-haiku-5-5
SMARTMASK_LLM_TIMEOUT=20
